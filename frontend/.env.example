# Base URL of the auction API backend.
# Required for local development (frontend :3000, backend :8080):
VITE_API_BASE_URL=http://localhost:8080
#
# Leave empty only when the API is served from the same origin (reverse proxy).
#
# REACT_APP_API_BASE_URL is still accepted for compatibility with existing
# .env.local files.
#
# Vite embeds VITE_ / REACT_APP_ variables in the public JS bundle at build
# time -- never put credentials, tokens or keys in this file.
